{
  "name": "sagar-portfolio",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0",
    "npm": "please use pnpm"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check": "pnpm -r --if-present run check",
    "fix": "pnpm -r --if-present run fix",
    "dev": "concurrently -k \"node src/server/index.mjs\" \"pnpm --dir src/frontend dev\"",
    "start": "node src/server/index.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "sharp": "^0.34.4"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "multer": "^2.0.2"
  }
}
